---
import { homeContent } from '../content/home';
import { servicesList } from '../content/services';
import { serviceIcons } from '../content/assets';
---

<section id="services" class="services-section" aria-labelledby="services-heading">
  <div class="container">
    <div class="services-header">
      <span class="section-badge">{homeContent.servicesSection.badge}</span>
      <h2 id="services-heading" class="services-title">
        {homeContent.servicesSection.title}
      </h2>
      <p class="services-subtitle">
        {homeContent.servicesSection.subtitle}
      </p>
    </div>

    <div class="services-grid">
      {servicesList.map((service) => {
        const icon = serviceIcons[service.iconKey];
        return (
          <article class="service-card">
            <div class="service-card__header">
              <div class="service-card__icon-wrap">
                <img
                  src={icon.src}
                  alt=""
                  width="44"
                  height="44"
                  aria-hidden="true"
                />
              </div>
              <div>
                <h3 class="service-card__title">{service.title}</h3>
                <span class="service-card__price">{service.priceFrom}</span>
              </div>
            </div>

            <p class="service-card__summary">{service.summary}</p>

            <div class="service-card__faults">
              <h4 class="service-card__subheading">Common Faults We Fix:</h4>
              <ul class="fault-list">
                {service.commonFaults.map((fault) => (
                  <li class="fault-item">
                    <span class="fault-dot" aria-hidden="true">•</span>
                    <span>{fault}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="service-card__brands">
              <span class="brands-label">Brands Repaired:</span>
              <p class="brands-text">{service.supportedBrands.join(', ')} & more</p>
            </div>

            <button
              type="button"
              class="btn btn--outline btn--full service-card__btn open-quote-modal"
              data-appliance={service.title}
            >
              Enquire About {service.title}
            </button>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: var(--space-16) 0;
    background-color: var(--color-brand-mist);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 1024px) {
    .services-section {
      padding: var(--space-20) 0;
    }
  }

  .services-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .section-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-white);
    color: var(--color-brand-teal);
    border: 1px solid var(--color-brand-mist-border);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .services-title {
    font-size: var(--font-size-2xl);
    color: var(--color-brand-navy);
  }

  @media (min-width: 768px) {
    .services-title {
      font-size: var(--font-size-3xl);
    }
  }

  .services-subtitle {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .service-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-teal);
  }

  .service-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .service-card__icon-wrap {
    width: 52px;
    height: 52px;
    background-color: var(--color-brand-mist);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .service-card__title {
    font-size: var(--font-size-md);
    color: var(--color-brand-navy);
  }

  .service-card__price {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-teal);
  }

  .service-card__summary {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
  }

  .service-card__faults {
    background-color: var(--color-brand-mist);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .service-card__subheading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-navy);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .fault-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fault-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-brand-navy);
    line-height: var(--line-height-snug);
  }

  .fault-dot {
    color: var(--color-brand-teal);
    font-weight: var(--font-weight-bold);
  }

  .service-card__brands {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-3);
  }

  .brands-label {
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-navy);
    display: block;
    margin-bottom: 2px;
  }

  .service-card__btn {
    margin-top: auto;
  }
</style>
