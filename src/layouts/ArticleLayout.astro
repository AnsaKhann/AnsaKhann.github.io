---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import ArticleMetadata from '../components/blog/ArticleMetadata.astro';
import BlogCTA from '../components/blog/BlogCTA.astro';
import { blogCopy } from '../content/blog';
import { businessInfo } from '../content/site';
import ArticleList from '../components/blog/ArticleList.astro';
import { getPublishedPosts } from '../lib/blog';
import { blogIndexURL, postURL, relatedPosts, searchTitle, siteUrl } from '../lib/blog-posts';
import '../styles/blog.css';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const canonicalUrl = `${siteUrl}${postURL(post)}`;
const related = relatedPosts(post, await getPublishedPosts());
// Social networks handle JPEG most reliably, so the sharing image is exported separately.
const socialImage = data.image
  ? await getImage({ src: data.image, width: Math.min(data.image.width, 1200), format: 'jpeg' })
  : undefined;
const imageUrl = socialImage ? new URL(socialImage.src, siteUrl).href : undefined;

const seo = {
  title: searchTitle(data.seoTitle ?? data.title, businessInfo.name),
  description: data.description,
  canonicalUrl,
  ogType: 'article',
  ...(imageUrl && { ogImage: imageUrl })
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    ...(data.summary && { abstract: data.summary }),
    inLanguage: 'en-GB',
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    mainEntityOfPage: canonicalUrl,
    url: canonicalUrl,
    articleSection: data.category,
    keywords: data.tags.join(', '),
    ...(imageUrl && { image: imageUrl }),
    author: { '@type': 'Organization', name: data.author, url: siteUrl },
    publisher: { '@id': `${siteUrl}/#organization` }
  },
  ...(data.faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer }
          }))
        }
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: blogCopy.label, item: `${siteUrl}${blogIndexURL}` },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl }
    ]
  }
];
---

<BaseLayout seo={seo} article={data} structuredData={structuredData}>
  <article class="blog-article">
    <div class="container blog-article__container">
      <nav class="blog-breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href={blogIndexURL}>{blogCopy.label}</a></li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>

      <header class="blog-article__header">
        <h1 class="blog-article__title">{data.title}</h1>
        {/* The quick answer below does the lead's job, so the description is only shown without one. */}
        {!data.summary && <p class="blog-article__lead">{data.description}</p>}
        <ArticleMetadata data={data} />
        {data.image && (
          <Image
            src={data.image}
            alt={data.imageAlt!}
            width={Math.min(data.image.width, 1200)}
            widths={[...[400, 800].filter((width) => width < data.image!.width), Math.min(data.image.width, 1200)]}
            sizes="(max-width: 800px) 100vw, 736px"
            format="webp"
            class="blog-article__image"
            loading="eager"
          />
        )}
      </header>

      {data.summary && (
        <aside class="blog-summary" aria-labelledby="blog-summary-title">
          <h2 id="blog-summary-title" class="blog-summary__title">{blogCopy.summary}</h2>
          <p>{data.summary}</p>
        </aside>
      )}

      <div class="blog-prose"><slot /></div>

      {data.faqs.length > 0 && (
        <section class="blog-faqs" aria-labelledby="blog-faqs-title">
          <h2 id="blog-faqs-title" class="blog-faqs__title">{blogCopy.faqs}</h2>
          {data.faqs.map((faq) => (
            <details class="blog-faq">
              <summary class="blog-faq__question">{faq.question}</summary>
              <p class="blog-faq__answer">{faq.answer}</p>
            </details>
          ))}
        </section>
      )}

      <footer class="blog-article__footer">
        {data.tags.length > 0 && (
          <p class="blog-article__tags">{blogCopy.tags}: {data.tags.join(' · ')}</p>
        )}
        <BlogCTA />
        {related.length > 0 && (
          <section class="blog-related" aria-labelledby="blog-related-title">
            <h2 id="blog-related-title" class="blog-related__title">{blogCopy.related}</h2>
            <ArticleList posts={related} heading="h3" />
          </section>
        )}
        <nav class="blog-article__nav" aria-label="Blog navigation">
          <a href={blogIndexURL}>← {blogCopy.back}</a>
          <a href="/rss.xml">{blogCopy.rss}</a>
        </nav>
      </footer>
    </div>
  </article>
</BaseLayout>
